    },
    "ObservationReceipt": {
      "tier": "CORE",
      "fields": {
        "observation_id": "id",
        "tick": "int",
        "agent_id": "cognitive_agent_id",
        "accessible": "dict[str,float] compact agent-accessible channels only",
