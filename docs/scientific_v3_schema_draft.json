        "provenance": "AGENT_ACCESSIBLE"
      },
      "gt_decomposition": {
        "tier": "RESEARCH/FORENSIC",
        "when": "event-driven or threshold / checkpoint",
        "fields": [
          "contributor_ids",
          "channel",
          "magnitudes"
        ]
      },
      "est_bytes_core": "180-350"
    },
    "DecisionReceipt": {
      "tier0_CORE": {
        "fields": [
          "decision_id",
          "tick",
          "agent_id",
          "observation_id",
          "selection_mode",
          "selection_source",
          "selection_rule",
          "selected_action_legacy",
          "selected_candidate_id?",
          "candidate_count",
          "fallback_reason?",
          "motor_id",
          "peer_evaluation?",
          "prediction_count_delta?",
          "prospective_delta?"
        ],
        "forbidden": "invented utility/motivation scores",
        "source": "CognitionTickResult + last_selection compact subset every tick",
        "est_bytes": "220-400"
      },
      "tier1_RESEARCH": {
        "adds": [
          "top_k_candidate_summaries (k<=3)",
          "competition_summary compact"
        ],
        "est_bytes_extra": "300-800"
      },
      "tier2_FORENSIC": {
        "adds": [
          "full scenario_groups/competition graph sampled or checkpointed"
        ],
        "note": "Do not emit full graph every tick by default"
      }
    },
    "MotorReceipt": {
      "tier": "CORE",
      "fields": {
        "motor_id": "id",
        "tick": "int",
        "agent_id": "id",
        "decision_id": "id",
        "schema": "COMPOSITE_MOTOR_V1",
        "components": {
          "locomotion": "WAIT|MOVE:*|NONE",
          "neck": "NONE|NECK_*",
          "oscillator": "control+emit fields",
          "push": "bool"
        },
        "selection_source": "string",
        "legacy_token": "LEGACY_COMPATIBILITY only",
        "intent_vs_realized": {
          "requested": "from composite intent",
          "realized_refs": "action_work_ledger / motor_apply / push receipts ids"
        }
      },
      "est_bytes": "160-280"
    },
    "ConsequenceReceipt": {
      "tier": "CORE",
      "fields": {
        "consequence_id": "id",
        "tick_from": "T",
        "tick_to": "T+1",
        "body_id": "physical_body_id",
        "motor_id": "id",
        "pose_delta": {
          "dx": "float",
          "dy": "float",
          "wrap_aware": true
        },
        "orientation_delta": {
          "d_theta": "float",
          "d_omega": "float"
        },
        "resource_delta": {
          "A": "float",
          "B": "float",
          "work": "float"
        },
        "deform_delta": {
          "d_alpha": "float?"
        },
        "event_refs": [
          "contact",
          "push",
          "signal_emit",
          "signal_recv",
          "transfer",
          "deform"
        ],
        "force_contrib_compact?": "optional RESEARCH: env_site/endo/action norms"
      },
      "est_bytes": "140-260"
    },
    "RevisionReceipt": {
      "tier": "RESEARCH when mechanism enabled else NOT_APPLICABLE",
      "fields": [
        "revision_id",
        "tick",
        "agent_id",
        "prior_prediction_ref",
