#!/usr/bin/env bash
# MM Observer — primary user-facing launcher (Acanthostega Beta 4.0).
# Double-click this file. It owns the application window and backend lifecycle.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  LINK="$(readlink "$SOURCE")"
  case "$LINK" in
    /*) SOURCE="$LINK" ;;
    *) SOURCE="$DIR/$LINK" ;;
  esac
done
ROOT="$(cd "$(dirname "$SOURCE")" && pwd)"
exec "$ROOT/launch_psy_observer.sh" "$@"
